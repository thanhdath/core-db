{
 "generic_sampling_rules": {
  "integer_pk": "Sequential from 1; unique; never NULL; exactly the target row count; draw from a set disjoint from compact PKs and already-drawn values, resampling until unique; never drop rows.",
  "integer_fk": "Uniform over the parent table's finalized PK values in the same instance; never NULL where NOT NULL; where the column is NULL-targeted, 5-30% NULL and the rest reference valid parents; never plant NULL into a NOT NULL FK; draw only after parent PKs are finalized.",
  "varchar_short": "Random token of 3-12 alphanumeric chars; 20-50% duplicate share for DISTINCT-targeted columns; near-variants (one char changed) around listed equality literals.",
  "varchar_name": "Random capitalized word 4-10 chars; 20-50% duplicate share where DISTINCT-targeted.",
  "varchar_email": "lower(name) + '@example.' + {com,org,net}; unique per row.",
  "varchar_phone": "Random US-style pattern '(NNN)NNN-NNNN' or 'NNN.NNN.NNNNxNNNN'; 20-50% duplicate share where DISTINCT-targeted.",
  "varchar_password": "20 lowercase hex chars.",
  "varchar_quantity": "String of an integer 1-9.",
  "varchar_nullable_comment": "NULL for all rows (null_rate 1.0 in stats).",
  "datetime": "Uniform between 2009-01-01 and 2018-12-31, format '%Y-%m-%d %H:%M:%S'; 20-50% duplicate share where DISTINCT-targeted.",
  "decimal_money": "Uniform 0.00-2000.00, 2 decimals; 5-30% NULL where nullable and NULL-targeted.",
  "decimal_rate": "Uniform 0.00-20.00, 2 decimals.",
  "varchar_enum_small": "Uniform over listed enum values.",
  "boundary_numeric": "For each listed literal L, include L-1, L, L+1 (or L-0.01, L, L+0.01 for decimals).",
  "boundary_text": "For each listed equality literal S, include S and one-char variants of S; emit exactly the listed literals plus one-char variants; do not overwrite with group mix.",
  "tie_order_limit": "Ensure at least two rows share the top rank value of the ORDER column so LIMIT 1 is ambiguous.",
  "group_size_mix": "For GROUP-targeted non-key columns ensure groups of size 1, 2 and >=3 exist on the final written rows (apply after NULL planting); never apply to PK or NOT NULL unique columns.",
  "null_share": "Derive NULL eligibility and per-column share from the compact database: 0% stays 0%, non-zero share is preserved, every nullable column gets at least one NULL row per instance; never NULL in NOT NULL or PK columns; apply NULL planting before group/duplicate mix so targets hold on persisted rows.",
  "parent_without_children": "Explicitly reserve some parent PKs that no child row references (parent rows without children); child FK draws exclude reserved PKs; reservation must survive parent dict rebuild."
 },
