 "semantic_rules_and_formulas": [
  {
   "table": "circuits",
   "column": "lat",
   "formula": "lat BETWEEN -90 AND 90"
  },
  {
   "table": "circuits",
   "column": "lng",
   "formula": "lng BETWEEN -180 AND 180"
  },
  {
   "table": "races",
   "column": "year",
   "formula": "year BETWEEN 1950 AND 2017"
  },
  {
   "table": "races",
   "column": "round",
   "formula": "round BETWEEN 1 AND 21"
  },
  {
   "table": "races",
   "column": "date",
   "formula": "date >= '1950-01-01' AND date <= '2017-12-31'"
  },
  {
   "table": "races",
   "column": "date",
   "formula": "date >= printf('%04d-01-01', year) AND date <= printf('%04d-12-31', year)",
