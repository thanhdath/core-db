{
 "generic_sampling_rules": {
  "integer_pk": "sequential from 1, unique, never NULL",
  "integer_fk": "sample from parent PK pool; 5% NULL where nullable",
  "integer_numeric": "uniform in observed min..max; include min-1, min, max, max+1 unless a semantic range rule constrains the column, in which case emit only min and max",
  "real_numeric": "uniform in observed min..max rounded to 1 decimal; include bounds",
  "text_short": "pick from observed pool; 10% near-variant (case/typo)",
  "text_url": "http://en.wikipedia.org/wiki/<slug>",
  "text_date": "uniform date in 1950-01-01..2017-12-31 formatted %Y-%m-%d",
  "text_time": "HH:MM:SS uniform 00:00:00..23:59:59",
  "text_laptime": "M:SS.mmm uniform 1:20.000..1:40.000",
  "text_nullable": "80% observed pool, 20% NULL",
  "enum_small": "uniform over listed values",
  "tie_rank": "ensure at least two rows share the top value of the ORDER column",
  "null_share": "5-30% NULL on nullable columns",
  "boundary_emission": "for columns with a semantic range rule, emit only the in-range boundary values (min and max), never min-1 or max+1"
 },
