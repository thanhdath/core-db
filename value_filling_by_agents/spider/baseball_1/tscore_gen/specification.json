{
 "generic_sampling_rules": {
  "text_id": "Sample from a pool of realistic short identifiers (3-5 uppercase letters/digits for team/league/park ids, 8-10 lowercase letters+digits for player ids). Include near-variants (case changes, one-char edits) at ~5% share.",
  "text_name": "Sample from a pool of realistic names; include near-duplicate variants (case, spacing) at ~5% share.",
  "text_code": "Sample from the enum pool defined in per_column_exceptions; otherwise short uppercase codes.",
  "integer_count": "Sample integers in [0, 200] with a long tail; include boundary values 0,1,2,3 and one step around each listed literal.",
  "integer_year": "Sample years in [1871, 2015]; include boundary values at each listed literal and one step on each side.",
  "numeric_measure": "Sample non-negative numerics in [0, 1000] with decimals where the column is NUMERIC; include 0 and small values.",
  "numeric_rate": "Sample numerics in [0, 1] with 2-3 decimals.",
  "date_text": "Sample ISO dates 'YYYY-MM-DD' in [1871-01-01, 2015-12-31].",
  "nullable": "Each nullable column gets NULL in ~2% of rows (at least one NULL row per instance); non-NULL values follow the column rule.",
  "fresh_values": "For DISTINCT-target columns, ensure at least 20-50% duplicate share by drawing from a small pool; for tie-target ORDER columns, plant at least two groups sharing the top aggregate value.",
  "planting_order": "Apply near-variants and clamping first, then plant boundary/literal/enum values last so required values survive in the final instance; protect planted values from perturbation.",
  "fk_null_rule": "For FK columns, non-NULL values are drawn from the parent's generated values; NULL is allowed only where the column is nullable. When the parent is empty, all child FK values are NULL (never 0)."
 },
