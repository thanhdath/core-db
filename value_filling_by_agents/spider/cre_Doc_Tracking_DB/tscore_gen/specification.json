{
 "generic_sampling_rules": {
  "integer_pk": "Sequential integers starting at 1, unique per table; never NULL; PK columns never receive duplicates.",
  "integer_fk": "Sample from the parent table's generated key pool; allow NULL only if the column is nullable; planted NULLs are preserved through all post-processing.",
  "char_code": "Uppercase alphanumeric codes of length 1-15 drawn from the table's enum pool; never NULL when NOT NULL; case variants used only as boundary literals where the enum rule is case-insensitive.",
  "varchar_text": "Short human-readable strings; 20-50% near-duplicate variants (case/whitespace changes) on DISTINCT-targeted non-PK columns; NULL only when nullable.",
  "datetime": "Random timestamps in '%Y-%m-%d %H:%M:%S' between 1970-01-01 and 2020-12-31; NULL only when nullable.",
  "numeric_range": "Integers within the observed min/max; quantities > 0, amounts >= 0.",
  "enum_flag": "Pick uniformly from the listed enum values; never NULL when NOT NULL.",
  "boundary": "For each listed literal, include the literal itself, one step below and one step above (numbers by 1, dates by 1 day, strings by case/whitespace variant); boundary literals must survive semantic-rule post-processing (rules are case-insensitive where case variants are targeted).",
  "tie": "For ORDER-targeted columns, plant at least two rows sharing the rank-1 value.",
  "null_share": "Each nullable column gets at least one NULL row per instance; share follows the compact database's null_rate for that column (derived from schema.original_values, not hard-coded); a planted NULL is never replaced to satisfy a rule (three-valued logic).",
  "group_and_aggregate": "Group-size and aggregate-boundary shaping on the same column is done in a single joint pass; post-generation assertion verifies each target group size and COUNT value occurs.",
  "reference_table_fill": "Reference tables (Ref_Document_Types, Ref_Locations, Roles) are filled to their table_sizes_per_instance with fresh PKs above the compact max; post-write assertion checks rows_added equals the specified size."
 },
