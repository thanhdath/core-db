{
 "generic_sampling_rules": {
  "integer_pk": "Sequential 1..N per table; no NULL; never reused; PK columns are never mutated by boundary/duplicate/group-size patterns.",
  "integer_fk": "Drawn only from parent keys that survive insertion (re-derived after PK dedup and row skipping); NULL only for nullable FK columns; never NULL for NOT NULL FK columns.",
  "varchar_short": "Random short token from a small vocabulary; near-duplicates allowed for text columns.",
  "varchar_enum": "Random pick from the listed enum; no NULL unless the column is nullable.",
  "datetime": "Uniform random timestamp within [2017-01-01, 2018-12-31]; format %Y-%m-%d %H:%M:%S; order rules applied after sampling.",
  "varchar_free": "Random short phrase from a pool; NULL allowed when nullable.",
  "null_share": "Nullable columns get a NULL share matching the compact database's share for that column; at least one NULL row per nullable column per instance; NOT NULL and PK columns never get NULL.",
  "boundary": "For numeric columns, one boundary value at each listed literal and one step on each side; for dates, one day on each side of the literal while keeping the table's date-order rules.",
  "tie_and_duplicate": "For DISTINCT/ORDER columns, ensure duplicates at 20-50% share and ties at the listed rank; ties are computed over the joined/derived relation, not the raw PK.",
  "unmatched": "For join columns, achieve 'parent rows without children' by omitting some parent keys from the child draw; plant NULL only on nullable FK columns; never write NULL to a NOT NULL FK column."
 },
