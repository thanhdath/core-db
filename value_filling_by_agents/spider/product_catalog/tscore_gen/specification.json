 "semantic_rules_and_formulas": [
  {
   "table": "Attribute_Definitions",
   "column": "attribute_data_type",
   "formula": "attribute_data_type IN ('Bool')"
  },
  {
   "table": "Catalog_Structure",
   "column": "catalog_level_name",
   "formula": "catalog_level_name IN ('Category','Sub-Category','Product')"
  },
  {
   "table": "Catalog_Contents_Additional_Attributes",
   "column": "attribute_value",
   "formula": "attribute_value IN ('0','1')"
  },
  {
   "table": "Catalog_Contents",
   "column": "price_in_dollars",
   "formula": "price_in_dollars >= 0"
  },
  {
   "table": "Catalog_Contents",
   "column": "price_in_euros",
   "formula": "price_in_euros >= 0"
  },
  {
   "table": "Catalog_Contents",
   "column": "price_in_pounds",
   "formula": "price_in_pounds >= 0"
  },
  {
   "table": "Catalogs",
   "column": "date_of_latest_revision",
   "formula": "date_of_latest_revision >= date_of_publication"
  }
 ],
