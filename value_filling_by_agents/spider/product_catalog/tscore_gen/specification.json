{
 "generic_sampling_rules": {
  "integer_pk": "Sequential from 1; never NULL; unique per table.",
  "integer_fk": "Copy from parent pool; nullable FKs get NULL on ~10% of rows and a parent id otherwise.",
  "varchar_short": "Random token of 3-12 alnum chars; 5% near-variants (case/typo) of an existing value; 5% NULL if nullable.",
  "varchar_code": "Random 2-3 char lowercase code plus space plus 2-char code, e.g. 'ab cd'; 5% NULL if nullable.",
  "double_price": "Uniform(0.01, 999.99) rounded to 2 decimals; 5% NULL if nullable.",
  "varchar_dimension": "Integer string in 1..20; 5% NULL if nullable.",
  "datetime": "Uniform between 2010-01-01 and 2018-12-31, format %Y-%m-%d %H:%M:%S; 5% NULL if nullable.",
  "boundary": "For each listed literal L, emit L, L-1, L+1 (numeric) or one day before/after (date) in at least one row.",
  "tie": "For ORDER columns, plant at least two rows sharing the rank-1 value.",
  "duplicate": "For DISTINCT columns, ensure 20-50% of non-NULL values repeat an earlier value.",
  "null_share": "Every nullable column gets at least one NULL row; share ~5-10%."
 },
 "per_column_exceptions": [
  {
   "pattern": "enum",
   "columns": [
    "Attribute_Definitions.attribute_data_type"
   ],
   "targets": [
    "Bool"
   ]
  },
  {
   "pattern": "enum",
   "columns": [
    "Catalog_Structure.catalog_level_name"
   ],
   "targets": [
    "Category",
    "Sub-Category",
    "Product"
   ]
  },
  {
   "pattern": "enum",
   "columns": [
    "Catalog_Contents_Additional_Attributes.attribute_value"
   ],
   "targets": [
    "0",
    "1"
   ]
  },
  {
   "pattern": "duplicates_for_distinct",
   "columns": [
    "Attribute_Definitions.attribute_data_type",
    "Catalog_Contents.catalog_entry_name",
    "Catalogs.catalog_publisher"
   ],
   "targets": {
    "duplicate_share": "20-50 %"
   }
  },
  {
   "pattern": "group_sizes",
   "columns": [
    "Attribute_Definitions.attribute_data_type",
    "Catalog_Contents_Additional_Attributes.attribute_id"
   ],
   "targets": {
    "group_sizes": "1, 2 and >= 3"
   }
  },
  {
   "pattern": "aggregate_boundary",
   "columns": [
    "Attribute_Definitions.attribute_data_type",
    "Catalogs.date_of_latest_revision"
   ],
   "targets": {
    "aggregate": [
     "COUNT(*)"
    ],
    "values": [
     0,
     1,
     2,
     3,
     4
    ]
   }
  },
  {
   "pattern": "comparison_boundary",
   "columns": [
    "Attribute_Definitions.attribute_data_type",
    "Catalog_Contents.length",
    "Catalog_Contents.width",
    "Catalog_Structure.catalog_level_number"
   ],
   "targets": {
    "values": [
     2,
     3,
     4,
     5,
     6,
     -5,
     -4,
     -3,
     ""
    ]
   }
  },
  {
   "pattern": "ties_for_order_limit",
   "columns": [
    "Catalog_Contents.price_in_dollars",
    "Catalog_Contents.price_in_euros",
    "Catalog_Contents.capacity",
    "Catalog_Contents.next_entry_id",
    "Catalogs.catalog_publisher"
   ],
   "targets": {
    "tie_at_rank": [
     1
    ],
    "direction": "ASC and DESC"
   }
  },
  {
   "pattern": "rows_with_different_values",
   "columns": [
    "Catalog_Contents.price_in_dollars",
    "Catalog_Contents.height"
   ],
   "targets": {
    "qualifying_rows": ">= 2 per group with different values"
   }
  },
  {
   "pattern": "unmatched_join_rows",
   "columns": [
    "Attribute_Definitions.attribute_id",
    "Catalog_Contents.catalog_level_number",
    "Catalog_Contents_Additional_Attributes.attribute_id",
    "Catalog_Structure.catalog_level_number",
    "Catalogs.catalog_id",
    "Catalog_Contents.next_entry_id"
   ],
   "targets": {
    "parent_rows_without_children": true,
    "child_rows_with_null_fk": false
   }
  },
  {
   "pattern": "like_near_variant",
   "columns": [
    "Catalogs.catalog_publisher"
   ],
   "targets": [
    "%Mur%",
    "%Murray%"
   ]
  },
  {
   "pattern": "null_rows",
   "columns": [
    "Attribute_Definitions.attribute_data_type"
   ],
   "targets": [
    "",
    "x"
   ]
  },
  {
   "pattern": "literal_pool",
   "columns": [
    "Attribute_Definitions.attribute_name",
    "Catalog_Contents.product_stock_number"
   ],
   "targets": [
    "Green",
    "2%"
   ]
  }
 ],
