  },
  {
   "table": "invoice_lines",
   "column": "unit_price",
   "formula": "invoice_lines.unit_price = tracks.unit_price VIA invoice_lines.track_id"
  },
  {
   "table": "invoices",
   "column": "billing_address",
   "formula": "invoices.billing_address = customers.address VIA invoices.customer_id"
  },
  {
   "table": "invoices",
   "column": "billing_city",
   "formula": "invoices.billing_city = customers.city VIA invoices.customer_id"
  },
  {
   "table": "invoices",
   "column": "billing_state",
   "formula": "invoices.billing_state = customers.state VIA invoices.customer_id"
  },
  {
   "table": "invoices",
   "column": "billing_country",
   "formula": "invoices.billing_country = customers.country VIA invoices.customer_id"
  },
  {
   "table": "invoices",
   "column": "billing_postal_code",
