{
 "generic_sampling_rules": {
  "integer_pk": "Sequential 1..N per table, no NULL, no reuse.",
  "integer_fk": "Uniform pick from parent PK pool; nullable FKs get NULL share per null_targets; planted NULLs are never overwritten.",
  "varchar_text": "Pick from a small curated pool per column; 10% chance of a near-variant (case flip, trailing space, prefix/suffix) when the column is not an enum.",
  "varchar_enum": "Uniform pick from the explicit enum list in per_column_exceptions.",
  "numeric_money": "Uniform pick from {0.99, 1.99} for unit_price; totals computed by formula.",
  "numeric_quantity": "Always 1 (matches observed distinct=1).",
  "timestamp": "Uniform datetime in 2002-01-01..2010-12-31 00:00:00, stored as datetime objects and formatted %Y-%m-%d %H:%M:%S only at write time; never mix str and datetime in a column.",
  "nullable_share": "Each nullable column: at least one NULL row per instance; share follows compact DB null_rate (rounded up to >=1 row).",
  "boundary_values": "For columns listed in per_column_exceptions with pattern comparison_boundary: include the literal, its case-flipped variant, and one value on each side (lexicographic neighbor for text). Per-column target lists override the generic neighbor requirement.",
  "distinct_duplicates": "For columns with pattern duplicates_for_distinct: ensure 20-50% of non-NULL values repeat an earlier value; post-check the final share and adjust deterministically if outside [0.20, 0.50].",
  "order_ties": "For columns with pattern ties_for_order_limit: plant at least two rows sharing the value at the listed rank, only when the table has enough rows for that rank.",
  "group_sizes": "For columns with pattern group_sizes: ensure at least one value with count 1, one with count 2, one with count >= 3; for FK columns restrict the pool to valid parent ids.",
  "unmatched_join_rows": "For join columns with pattern unmatched_join_rows: ensure at least one parent row with no child and (if nullable) at least one child row with NULL FK; verify after planting.",
  "aggregate_boundary": "For columns with pattern aggregate_boundary: ensure a parent group with child count exactly 9, 10, and 11; skip NULL child FKs when assigning counts.",
  "like_near_variant": "For columns with pattern like_near_variant: include the literal, a %literal% variant, and a case-flipped variant.",
  "null_in_count_column": "For columns with pattern null_in_count_column: ensure at least one NULL row (only if nullable) so COUNT(col) < COUNT(*)."
 },
