{
 "generic_sampling_rules": {
  "integer_pk": "Sequential integers starting at 1, unique per table; never NULL.",
  "integer_fk": "Uniformly sample an existing parent key from the final surviving parent key set (compact + generated, after dedup); never NULL for NOT NULL FK columns; ~5% NULL only if the column is nullable; ensure at least one parent row has no children.",
  "varchar_text": "Random string of length 4-12 drawn from lowercase letters plus space and digits; 20-50% duplicate share for DISTINCT-targeted columns; near-variants (case/whitespace/one-char edits) of listed equality literals; 0.3 of text values fresh, 0.7 drawn from observed pool.",
  "varchar_short_enum": "Uniform choice from the table's enum list; case variants (lower/upper) allowed only where listed.",
  "datetime": "Random timestamp between 1970-01-01 and 2015-12-31 23:59:59 in '%Y-%m-%d %H:%M:%S'; boundary values at each listed literal and one day on each side planted with probability 0.35 per instance.",
  "nullable_columns": "Every nullable column receives NULL treatment: k = clamp(round(n*share), 1, n-1) so at least one NULL and at least one non-NULL generated row always exist; a compact share of 1.0 does not force all-NULL.",
  "boundary_numbers": "For each numeric literal L in targets, include L-1, L, L+1 with probability 0.35 per instance.",
  "boundary_dates": "For each date literal D, include D-1 day, D, D+1 day in the column format with probability 0.35 per instance.",
  "tie_ranks": "For ORDER-targeted aggregate columns, plant at least two parent rows sharing the rank-1 aggregate value (tie_rank read from per_column_exceptions).",
  "fresh_value_share": "0.3 of text values are fresh (not from the observed pool); 0.7 drawn from observed pool."
 },
