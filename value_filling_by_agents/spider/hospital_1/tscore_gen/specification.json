  },
  {
   "table": "Medication",
   "column": "Code",
   "formula": "Code > 0"
  },
  {
   "table": "Prescribes",
   "column": "Dose",
   "formula": "CAST(Dose AS INTEGER) > 0"
  },
  {
   "table": "Block",
   "column": "BlockFloor",
   "formula": "BlockFloor >= 0"
  },
  {
   "table": "Block",
   "column": "BlockCode",
   "formula": "BlockCode >= 0"
  },
  {
   "table": "Room",
   "column": "Unavailable",
   "formula": "Unavailable IN (0, 1)"
  },
  {
   "table": "Room",
   "column": "RoomNumber",
   "formula": "RoomNumber > 0"
  },
  {
   "table": "On_Call",
   "column": "OnCallEnd",
   "formula": "OnCallEnd > OnCallStart"
  },
  {
   "table": "Stay",
   "column": "StayEnd",
   "formula": "StayEnd >= StayStart"
  },
  {
   "table": "Undergoes",
   "column": "DateUndergoes",
   "formula": "DateUndergoes >= (SELECT StayStart FROM Stay WHERE Stay.StayID = Undergoes.Stay)",
   "evidence": "sample rows 05-02..05-13 vs stays 05-01..05-14; enforced as DateUndergoes >= StayStart"
  }
 ],
