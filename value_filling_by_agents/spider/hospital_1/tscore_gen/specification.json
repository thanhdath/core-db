{
 "generic_sampling_rules": {
  "integer_pk": "Sequential integers starting at 1, unique per table; never NULL; assigned after all parent tables are final.",
  "integer_fk": "Sample from the parent table's FINAL key pool (after PK dedup and unique-column drops); nullable FKs get NULL with the column's null share and at least one NULL row per instance.",
  "integer_numeric": "Uniform integer in [1, 1000] unless a per-column exception gives a range.",
  "real_numeric": "Uniform real rounded to 2 decimals in [0, 20000] unless a per-column exception gives a range; always emit a numeric value (never a string token).",
  "varchar_short": "Random token of 3-12 ASCII letters, first letter capitalized; near-variants (case change, one-char edit) for equality literals.",
  "varchar_name": "Random first+last name from a small pool; duplicates allowed at 20-50% share where DISTINCT is exercised.",
  "varchar_numeric_text": "For text columns whose values are parsed as numbers (only Prescribes.Dose), emit a decimal string of digits only, e.g. '5' or '10'; never letters.",
  "boolean": "0 or 1 with equal probability; boundary probes outside {0,1} are used only for comparison, never stored.",
  "datetime": "Random datetime in 2008-01-01..2008-12-31, formatted per column exception; order rules applied after sampling; no leading-zero stripping.",
  "text_room": "Random single uppercase letter A-Z.",
  "null_share": "For nullable columns, 20% NULL unless a per-column exception states otherwise; at least one NULL row per nullable column per instance, even when the table has a single generated row.",
  "boundary": "For numeric columns with a listed literal L, include L-1, L, L+1; for dates include L-1 day, L, L+1 day; comparison-only probes are never stored.",
  "tie": "For ORDER columns with listed ranks, plant at least two rows sharing the tie value at that rank.",
  "fresh_share": "30% of non-key values are fresh random draws; 70% drawn from the parent/related pool.",
  "fk_finality": "All child FK values are validated against the final parent key set before writing; foreign_keys pragma is ON during insert so violations surface as counted failures."
 },
