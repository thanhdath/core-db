 "generic_sampling_rules": {
  "int": "Sample integer uniformly within the column's semantic range (or [min,max] of the column when no range rule exists); 5-30% NULL when nullable; never NULL for primary keys.",
  "text": "Sample from a short pool of distinct values; 20-50% near-duplicate variants (case, trailing space, one extra char); 5-30% NULL when nullable.",
  "date": "Sample date in ISO 8601 YYYY-MM-DD; 5-30% NULL when nullable.",
  "boundary": "Include values at each literal boundary and one step on each side (ints +/-1, dates +/-1 day, text case variants and near-duplicate strings), clamped to the column's semantic range so no injected value violates a declared formula.",
  "near_variant": "For each LIKE literal, generate the exact literal and a near variant (e.g. '%Mik%' for '%Mike%').",
  "duplicates_for_distinct": "For DISTINCT columns, ensure 20-50% of rows share a value with another row.",
  "tie": "For ORDER columns, ensure at least one tie at the minimum rank.",
  "null": "For nullable columns, include a NULL share (5-30%) and at least one NULL row per column per instance; nullable foreign keys with an unmatched_join_rows target also get at least one NULL.",
  "fresh": "Fresh values are generated from the pool; no reuse of original values."
 },
