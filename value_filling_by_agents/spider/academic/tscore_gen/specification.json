{
 "generic_sampling_rules": {
  "int_primary_key": "Sequential integers starting at 1, step 1, unique per table; never NULL.",
  "int_foreign_key": "Sample from the parent table's generated primary-key values; with probability 0.10 emit NULL when the column is nullable; otherwise always a valid parent key. Never emit dangling keys for columns bound by a declared FOREIGN KEY.",
  "int_numeric": "Uniform integer in [1, 1000] unless a per-column exception gives a range; never NULL for NOT NULL columns.",
  "text_generic": "Random token from a small vocabulary of 3-8 lowercase words joined by spaces; with probability 0.10 emit NULL when nullable.",
  "text_name": "Title-cased two-word name from a fixed first/last name pool; with probability 0.10 emit NULL when nullable.",
  "text_homepage": "https://example.org/<slug> where slug is 4-10 lowercase letters; with probability 0.10 emit NULL when nullable.",
  "text_abstract": "2-4 sentences of 6-12 words each; with probability 0.10 emit NULL when nullable.",
  "near_variant": "For each listed LIKE/equality literal, generate the literal itself, a case variant, a one-character substitution variant, and a variant with a trailing ' x'. Only applied to TEXT columns; never applied to INT columns.",
  "boundary_numeric": "For each listed numeric literal L, generate L-1, L, L+1.",
  "boundary_text": "For each listed text literal, generate the literal, its lowercase form, and a one-character-edit near variant.",
  "duplicates_for_distinct": "On DISTINCT-target columns, repeat 20-50% of generated values so COUNT(DISTINCT) < COUNT(*).",
  "null_share": "Every nullable column gets at least one NULL row per instance; share 10% unless a per-column exception says otherwise.",
  "unmatched_join_rows": "For join columns, generate 5-15% of parent rows with no child rows (orphan parents). Do NOT generate dangling child foreign keys; child FK values are always valid parent keys or NULL when nullable.",
  "tie_at_limit": "On ORDER-target columns, generate ties at the listed rank boundary (e.g. two rows with the same value at the cutoff)."
 },
