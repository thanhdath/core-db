{
 "generic_sampling_rules": {
  "integer_pk": "fresh sequential integers starting at 1, unique per table; never NULL",
  "integer_fk": "copy from parent pool; NULL share per null_targets when nullable; 10% of parent rows left without children",
  "integer_numeric": "uniform in observed min..max; NULL share per null_targets when nullable",
  "integer_64": "for 64-bit integer columns (events.device_id, events_relevant.device_id, gender_age.device_id, gender_age_train.device_id, gender_age_test.device_id, phone_brand_device_model2.device_id, sample_submission.device_id): draw from a 64-bit-safe range (e.g. uniform in [-2**63, 2**63-1] or a fixed pool of observed literals); never clamp to 32-bit; boundary literals sampled directly from the boundary set plus one step on each side",
  "text_enum": "pick from explicit enum pool; NULL share per null_targets when nullable",
  "text_free": "pick from small pool of observed literals plus case variants; NULL share per null_targets when nullable",
  "datetime": "uniform between 2016-01-01 and 2016-12-31, format '%Y-%m-%d %H:%M:%S.0'; NULL share per null_targets when nullable",
  "real_coord": "longitude uniform 0..180, latitude uniform 0..90; NULL share per null_targets when nullable",
  "real_prob": "uniform 0..1 rounded to 4 decimals",
  "boundary": "for each listed literal include literal, literal-step, literal+step; for 64-bit integer columns use the integer_64 rule so no 32-bit clamp applies",
  "near_variant": "for each LIKE/equality literal include case variants and prefix/suffix variants",
  "tie": "duplicate the value at the listed rank so ORDER BY has ties",
  "duplicate_share": "20-50% of rows repeat a value on the DISTINCT column",
  "null_share": "default 5-30% NULL on nullable columns; per-column compact shares in null_targets override this default (e.g. gender_age demographics 0.597, events_relevant.device_id 1.0); at least one NULL row per nullable column"
 },
