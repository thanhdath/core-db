 "semantic_rules_and_formulas": [
  {
   "table": "address_status",
   "column": "address_status",
   "formula": "address_status IN ('Active','Inactive')"
  },
  {
   "table": "order_status",
   "column": "status_value",
   "formula": "status_value IN ('Order Received','Pending Delivery','Delivery In Progress','Delivered','Cancelled','Returned')"
  },
  {
   "table": "shipping_method",
   "column": "cost",
   "formula": "cost >= 0"
  },
  {
   "table": "book",
   "column": "num_pages",
   "formula": "num_pages > 0"
  },
  {
   "table": "book",
   "column": "publication_date",
   "formula": "publication_date BETWEEN '1800-01-01' AND '2025-12-31'"
  },
  {
   "table": "order_line",
   "column": "price",
   "formula": "price >= 0"
  },
  {
   "table": "order_history",
   "column": "status_date",
   "formula": "status_date >= (SELECT order_date FROM cust_order WHERE cust_order.order_id = order_history.order_id)"
  },
  {
   "table": "cust_order",
   "column": "order_date",
   "formula": "order_date BETWEEN '2019-01-01 00:00:00' AND '2023-12-31 23:59:59'"
  },
  {
   "table": "book_language",
   "column": "language_code",
   "formula": "length(language_code) BETWEEN 2 AND 5"
  }
 ],
