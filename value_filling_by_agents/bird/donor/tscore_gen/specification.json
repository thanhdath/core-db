{
 "generic_sampling_rules": {
  "text_identifier": "32-char lowercase hex string; primary keys unique; foreign keys drawn from parent pool; NULL share per column statistics where nullable; no orphan values (FK integrity preserved)",
  "text_short_enum": "sample from the observed value pool for the column; include near-variants (case flip, trailing x, one-char substitution) at 5% of rows",
  "text_free": "sample from observed pool with 10% fresh near-duplicate variants; NULL share per column statistics",
  "text_long": "sample from observed pool; 5% near-duplicate variants; NULL share per column statistics",
  "real_amount": "non-negative REAL rounded to 2 decimals; range from statistics; NULL share per column statistics where nullable",
  "real_coordinate": "REAL in [-180,180] for longitude, [-90,90] for latitude; 20-50% duplicate share",
  "integer_count": "positive INTEGER; 20-50% duplicate share; NULL share per column statistics where nullable",
  "integer_zip": "5-digit INTEGER in [10000,99999]",
  "date_iso": "DATE formatted %Y-%m-%d; 20-50% duplicate share",
  "datetime_iso": "DATETIME formatted %Y-%m-%d %H:%M:%S.%f",
  "flag_tf": "TEXT IN ('t','f')",
  "near_variant": "for each listed literal L: include L, L||'x', lower(L), and one-char-substituted variant; for LIKE targets also include L||'%'; apply in both enum and generic sampling branches",
  "boundary": "for each listed literal L: include L, one step below, one step above (numbers by step, dates by one day); for text literals use case variants (L, lower(L), upper(L)); apply in both enum and generic sampling branches",
  "null_share": "each nullable column gets at least one NULL row; share follows column statistics",
  "duplicates_for_distinct": "20-50% of rows share a value with another row; apply after near-variant injection and re-check after NULL planting",
  "ties_for_order_limit": "at least two rows tie at the top ranks of the ORDER column",
  "unmatched_join_rows": "for each nullable FK: ~5% NULL values only (no orphan values, to preserve declared FK constraints); ensure some parent rows have no children by not referencing them"
 },
