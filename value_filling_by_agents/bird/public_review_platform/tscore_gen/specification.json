{
 "generic_sampling_rules": {
  "integer_pk": "Sequential integers starting at 1; unique per table; never NULL; never mutated by duplicate/tie/group planting.",
  "integer_fk": "Sample from the parent table's generated key pool; never NULL unless the column is nullable; never mutated by duplicate/tie/group planting after assignment; ~10% of parent rows have no child rows.",
  "integer_quantity": "Uniform integer in [0, 10]; ~5% NULL when nullable.",
  "integer_year": "Uniform integer in [2005, 2014].",
  "real_rating": "Uniform real in [1.0, 5.0] rounded to 1 decimal; ~10% NULL when nullable.",
  "text_enum": "Uniform choice from the column's enum pool; ~10% NULL when nullable.",
  "text_short": "Uniform choice from a small pool of short labels; ~10% NULL when nullable.",
  "text_time": "Uniform choice from ['12AM','1AM',...,'11PM'] (24 values); ~5% NULL when nullable.",
  "text_near_variant": "For each listed literal L, with probability 0.15 emit a near-variant: L with last char changed, L + 'x', or lower(L); otherwise emit L.",
  "text_boundary": "For each listed boundary literal L, emit L, lower(L), and one near-variant; ensure at least one row per literal.",
  "text_null_share": "For nullable text columns appearing in COUNT/IS NULL/LEFT JOIN/COALESCE, plant NULL in 5-30% of rows (at least one NULL row).",
  "duplicates_for_distinct": "On non-key columns flagged for DISTINCT, repeat 20-50% of values so COUNT(col) < COUNT(DISTINCT col). PK and FK columns are exempt.",
  "ties_for_order_limit": "On ORDER/LIMIT columns, plant at least two rows sharing the rank-1 aggregate value (and rank-5/rank-10 where listed). PK and FK columns are exempt from direct mutation; ties are realized via aggregate expressions over them.",
  "group_sizes": "Ensure groups of size 1, 2 and >=3 exist for the grouping column; PK and FK columns are exempt from direct mutation.",
  "unmatched_join_rows": "Ensure some parent rows have no child rows and some child rows reference existing parents; no NULL FKs unless nullable.",
  "fk_integrity": "After all planting, re-validate every FK value against the parent pool; remap any orphan to a valid parent key. Writer must run with pragma foreign_keys = ON and assert fk_violations = 0.",
  "compact_rows": "Every instance is built from a byte copy of the compact database; generated rows are appended, never deleting or changing compact rows.",
  "row_count": "Generated row counts per table must equal table_sizes_per_instance exactly; PK-collapse must not reduce counts."
 },
