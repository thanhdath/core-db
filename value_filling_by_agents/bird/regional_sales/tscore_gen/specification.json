{
 "generic_sampling_rules": {
  "integer_pk": "Sequential 1..N per table, unique, never NULL; no duplicate planting on PK columns.",
  "integer_fk": "Copy from parent PK pool; 5% NULL where nullable; include parent rows with no children; never apply near-variants to FK columns.",
  "text_enum": "Pick from explicit enum list; no near-variants on enum-constrained columns; 3% near-variants (case/whitespace) only where non-FK and no constraint forbids.",
  "text_free": "Synthetic short strings; 5% near-duplicates of existing values.",
  "text_money": "Format 'd,ddd.dd' with comma thousands separator; value in [0.01, 9999.99].",
  "real_rate": "Uniform in [0, 1] rounded to 3 decimals.",
  "date_mmddyy": "Format M/D/YY; sample within 2017-01-01..2019-12-31.",
  "boundary": "For each listed literal, include the literal, one step below and one step above; for text columns inject the literal and its case variant; for integer PK columns inject the literal values directly into the PK sequence.",
  "null_share": "Per nullable column, 2-5% NULL rows, at least one per instance; never applied to PK columns; applied to FK columns after copy.",
  "duplicates": "On DISTINCT-target columns, 20-50% duplicate share; never applied to PK columns; PK-column DISTINCT targets are realized as result-set duplicates via GROUP BY/DISTINCT query semantics, not base-column duplicates.",
  "ties": "On ORDER-target columns, plant ties at listed LIMIT ranks."
 },
