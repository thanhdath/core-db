{
 "generic_sampling_rules": {
  "integer_pk": "Sequential integers starting at 1, unique per table; never NULL.",
  "text_pk": "Short unique token built from a table prefix and a counter (e.g. 'IUCR0001'); never NULL.",
  "text_generic": "Draw from a small pool of realistic literals for the column's meaning; 5% of rows get a near-variant (case change, trailing space, or one-character edit) of a pool value.",
  "text_enum": "Draw uniformly from the enum list; 5% of rows get a case-variant of a listed value.",
  "integer_generic": "Uniform integer in [1, 1000] unless a per-column exception gives a range.",
  "numeric_boundary": "For each listed boundary literal L, generate rows at L-1, L, L+1 (or the date equivalent) so that both sides of the comparison are populated; the boundary must be emitted in the column's storage format (e.g. comma-formatted TEXT for Community_Area.population).",
  "null_share": "For each nullable column in null_targets, 5% of generated rows get NULL (at least one row per instance); NOT NULL and PK columns never get NULL; columns not listed in null_targets are never NULL.",
  "duplicates_for_distinct": "On non-PK columns flagged for DISTINCT, repeat 20-50% of values so that COUNT(DISTINCT) < COUNT(*); never apply to primary-key columns.",
  "ties_for_order_limit": "On columns flagged for ORDER/LIMIT, plant at least two rows sharing the top count (rank-1 tie) and, where listed, the 5th rank, so the requested rank ties occur on the aggregate.",
  "unmatched_join_rows": "For each FK column, 5% of child rows get a NULL FK; parent rows without children are achieved by not referencing every parent (no orphan keys are created).",
  "date_text": "Format 'M/D/YYYY H:MM' as in the sample; dates spread over 2018-01-01..2018-12-31.",
  "like_near_variant": "For each LIKE literal, generate the exact literal plus variants that match and variants that differ by one character or case; the variants are produced in the column's date/text format."
 },
