 "semantic_rules_and_formulas": [
  {
   "table": "Community_Area",
   "column": "community_area_no",
   "formula": "community_area_no > 0"
  },
  {
   "table": "Community_Area",
   "column": "side",
   "formula": "side IN ('Far North','North','Central','Northwest','West','South','Far Southeast','Southwest')"
  },
  {
   "table": "District",
   "column": "district_no",
   "formula": "district_no BETWEEN 1 AND 25"
  },
  {
   "table": "District",
   "column": "zip_code",
   "formula": "zip_code BETWEEN 60000 AND 60999"
  },
  {
   "table": "FBI_Code",
   "column": "crime_against",
   "formula": "crime_against IN ('Persons','Property','Society','Persons and Society')"
  },
  {
   "table": "IUCR",
   "column": "index_code",
   "formula": "index_code IN ('I','N')"
  },
  {
   "table": "Ward",
   "column": "ward_no",
   "formula": "ward_no BETWEEN 1 AND 50"
  },
  {
   "table": "Ward",
   "column": "Population",
   "formula": "Population >= 0"
  },
  {
   "table": "Crime",
   "column": "arrest",
   "formula": "arrest IN ('TRUE','FALSE')"
  },
  {
   "table": "Crime",
   "column": "domestic",
   "formula": "domestic IN ('TRUE','FALSE')"
  },
  {
   "table": "Crime",
   "column": "beat",
   "formula": "beat > 0"
  },
  {
   "table": "Crime",
   "column": "latitude",
   "formula": "CAST(latitude AS REAL) BETWEEN 41.6 AND 42.1"
  },
  {
   "table": "Crime",
   "column": "longitude",
   "formula": "CAST(longitude AS REAL) BETWEEN -87.95 AND -87.5"
  },
  {
   "table": "Crime",
   "column": "district_no",
   "formula": "district_no IN (SELECT district_no FROM District)"
  },
  {
   "table": "Crime",
   "column": "ward_no",
   "formula": "ward_no IN (SELECT ward_no FROM Ward)"
  },
  {
   "table": "Crime",
   "column": "community_area_no",
   "formula": "community_area_no IN (SELECT community_area_no FROM Community_Area)"
  },
  {
   "table": "Crime",
   "column": "fbi_code_no",
   "formula": "fbi_code_no IN (SELECT fbi_code_no FROM FBI_Code)"
  },
  {
   "table": "Crime",
   "column": "iucr_no",
