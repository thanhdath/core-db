{
 "generic_sampling_rules": {
  "integer_pk": "Sequential integers starting at 1, unique per table; never NULL; reserve and plant any listed comparison_boundary PK values inside the sequence.",
  "integer_fk": "Sample from the parent table's generated primary-key pool (compact values plus generated values); NULL only for columns listed in null_targets, at 5-30% share; ensure some parent rows have no children.",
  "integer_quantity": "Uniform integer in [1, 1000] unless a range rule narrows it.",
  "integer_amount": "Uniform integer in [0, 1000000000] unless a range rule narrows it.",
  "real_metric": "Uniform real in [0.0, 200.0] rounded to 6 decimals unless a range rule narrows it.",
  "text_short": "Random token of 3-20 lowercase letters; 20-50% duplicate share on DISTINCT-targeted columns; near-variants (case flip, trailing char, apostrophe-dropped and %-substituted forms) for equality/LIKE literals.",
  "text_long": "Random sentence of 40-250 characters.",
  "date_iso": "Random date between 1900-01-01 and 2025-12-31 formatted %Y-%m-%d; boundary dates at each listed literal and one day on each side.",
  "enum_small": "Uniform choice from the listed enum values; case-flipped near-variants for equality literals.",
  "null_share": "For nullable columns listed in null_targets, 5-30% NULL rows per instance; at least one NULL row per listed column; other nullable columns may take NULL but are not forced.",
  "boundary_numbers": "For each listed numeric literal L, include L-1, L, L+1.",
  "boundary_dates": "For each listed date literal D, include D-1 day, D, D+1 day.",
  "tie_ranks": "For ORDER/LIMIT target columns, plant ties at the listed ranks (1, 100) in both ASC and DESC directions.",
  "fresh_values": "All non-key text columns draw fresh random values; no reuse of observed literals except where listed as targets."
 },
