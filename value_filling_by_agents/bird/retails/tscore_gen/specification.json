{
 "generic_sampling_rules": {
  "integer_pk": "Sequential integers 1..N per table; never NULL; unique.",
  "integer_fk": "Copy from the parent table's final (post-dedup) key pool; nullable FK columns get NULL on 5% of child rows (at least one NULL per nullable FK column per instance); 3% of parent rows are left without children.",
  "integer_range": "Uniform integer in [1, 100000] unless a per-column exception narrows it.",
  "real_amount": "Uniform real in [0.00, 100000.00], rounded to 2 decimals; never negative for prices/costs.",
  "real_balance": "Uniform real in [-999.99, 9999.99], rounded to 2 decimals.",
  "real_rate": "Uniform real in [0.00, 1.00], rounded to 2 decimals.",
  "text_short": "Random alphanumeric string length 8-40.",
  "text_comment": "Random lowercase words joined by spaces, length 20-120.",
  "text_enum": "Uniform choice from the per-column enum list.",
  "text_near_variant": "For equality/LIKE literals: emit the literal, its upper-case and lower-case variants, and one near-variant (prefix/suffix change) with equal probability.",
  "date_iso": "Uniform date in 1992-01-01..1998-12-31 formatted %Y-%m-%d.",
  "boundary_numeric": "For each listed literal L emit L, L-step, L+step (step=1 for integers, 0.01 for reals).",
  "boundary_date": "For each listed literal D emit D, D-1 day, D+1 day in %Y-%m-%d.",
  "null_share": "For nullable non-FK columns: 10% NULL, 90% non-NULL; at least one NULL row per nullable column per instance. Nullable FK columns use the 5% FK NULL share above.",
  "duplicate_share": "For DISTINCT-target columns: 30% of rows reuse an earlier value.",
  "tie_share": "For ORDER/LIMIT-target columns: plant at least two rows sharing the rank-1 value (and rank-5 where listed).",
  "fresh_value_share": "70% fresh values, 30% reused from the pool.",
  "narrow_range_formula": "Columns whose formula restricts them to a narrow integer range (e.g. l_linenumber 1..7) are sampled directly from that range, never rejected and re-drawn.",
  "date_order_null": "Date-order rules constrain only non-NULL operand pairs; a NULL in any operand leaves the rule satisfied (SQL three-valued logic)."
 },
