{
 "generic_sampling_rules": {
  "integer_pk": "Sequential or random unique integers outside the range of natural keys; never NULL.",
  "integer_fk": "Sample from parent primary-key pool; reserve ~2% of rows for NULL when column is nullable.",
  "text_enum": "Pick uniformly from enumerated pool; add 2% case/whitespace near-variants where no constraint forbids.",
  "text_free": "Reuse city/county names from a small pool; ~30% repeated values to produce duplicates on DISTINCT.",
  "real_measure": "Positive real drawn from a log-normal-ish shape; round to 3 decimals for areas, 1 for ages.",
  "integer_count": "Non-negative integer; skew small via geometric with mean 5; include 0 and boundary 1.",
  "integer_amount": "Non-negative integer, rounded to nearest 1000; occasional large outlier.",
  "boundary": "For each listed literal L: emit L, L-step, L+step (numeric) or one-char case/whitespace variants (text).",
  "ties": "For ORDER/LIMIT rank 1: emit at least two rows sharing the top aggregate value; both ASC and DESC when specified.",
  "nulls": "Each nullable column gets >=1 NULL row; share follows original null_rate.",
  "table_size_sampling": "For each table, draw the generated row count uniformly from [0.5*base, 1.25*base] where base is table_sizes_per_instance; round to nearest integer; never exceed the original table size; parent tables are filled before children."
 },
