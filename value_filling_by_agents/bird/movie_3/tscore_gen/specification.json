{
 "generic_sampling_rules": {
  "integer_pk": "Sequential 1..N per table starting at 1; no NULL, no duplicates; for composite-PK tables draw unique tuples from parent pools instead.",
  "integer_fk": "Uniform pick from parent PK pool; NULL only if column nullable (share per null_targets); ensure at least one parent row with no children per FK.",
  "integer_numeric": "Uniform integer in [min,max] from stats; plant listed boundary literals and one step each side.",
  "real_numeric": "Uniform real rounded to 2 decimals in [min,max]; plant listed boundary literals and one step each side.",
  "text_short": "Pick from a small pool of 8-20 distinct values; 20-50% duplicate share; near-variants (case flip, one-char edit) for listed literals.",
  "text_long": "Concatenate 4-8 words from a 30-word pool; unique per row.",
  "datetime": "Uniform timestamp in [2005-01-01, 2006-02-15]; format '%Y-%m-%d %H:%M:%S.0'; plant listed boundary literals and one day each side.",
  "flag_enum": "Uniform pick from listed enum values.",
  "blob": "50% NULL, else fixed 16-byte hex literal.",
  "null_share": "For nullable columns: 1% NULL unless stats show higher; at least one NULL row per nullable column per instance; never all-NULL (require n>=2).",
  "tie_pattern": "For ORDER columns: plant at least 2 rows sharing the same COUNT(*) value at listed ranks.",
  "distinct_duplicate": "For DISTINCT columns: 20-50% of rows share values with another row.",
  "boundary_planting": "Reserve up to 6 rows per column to plant listed boundary literals; boundary values take precedence over semantic enum/range draws only when they satisfy the semantic rule; otherwise the semantic rule wins and the out-of-domain literal is dropped.",
  "composite_pk": "For film_actor and film_category draw unique (parent_a_id, parent_b_id) tuples from the two parent pools; deduplicate; never assign sequential values to composite-PK columns.",
  "copy_from_parent": "For film_text, iterate over generated film rows (or a subset) and copy film_id, title, description; do not generate independent PKs."
 },
