 "semantic_rules_and_formulas": [
  {
   "table": "film",
   "column": "film_id",
   "formula": "film_id > 0"
  },
  {
   "table": "film",
   "column": "rental_duration",
   "formula": "rental_duration BETWEEN 3 AND 7"
  },
  {
   "table": "film",
   "column": "rental_rate",
   "formula": "rental_rate IN (0.99, 2.99, 4.99)"
  },
  {
   "table": "film",
   "column": "replacement_cost",
   "formula": "replacement_cost BETWEEN 9.99 AND 29.99"
  },
  {
   "table": "film",
   "column": "rating",
   "formula": "rating IS NULL OR rating IN ('G','PG','PG-13','R','NC-17')"
  },
  {
   "table": "film",
   "column": "length",
   "formula": "length IS NULL OR length BETWEEN 46 AND 185"
  },
  {
   "table": "customer",
   "column": "active",
   "formula": "active IN (0, 1)"
  },
  {
   "table": "customer",
   "column": "store_id",
