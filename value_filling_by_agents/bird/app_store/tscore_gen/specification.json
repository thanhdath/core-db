 "semantic_rules_and_formulas": [
  {
   "table": "playstore",
   "column": "Rating",
   "formula": "Rating IS NULL OR Rating BETWEEN 1.0 AND 5.0"
  },
  {
   "table": "playstore",
   "column": "Reviews",
   "formula": "Reviews IS NULL OR Reviews >= 0"
  },
  {
   "table": "playstore",
   "column": "Type",
   "formula": "Type IS NULL OR Type IN ('Free', 'Paid', 'NaN')"
  },
  {
   "table": "playstore",
   "column": "Content Rating",
   "formula": "\"Content Rating\" IS NULL OR \"Content Rating\" IN ('Everyone', 'Teen', 'Everyone 10+', 'Mature 17+', 'Adults only 18+', 'Unrated')"
  },
  {
   "table": "playstore",
   "column": "Price",
   "formula": "Price IS NULL OR CAST(REPLACE(Price, '$', '') AS REAL) >= 0"
  },
  {
   "table": "playstore",
   "column": "Installs",
   "formula": "Installs IS NULL OR Installs LIKE '%,%+' OR Installs LIKE '%+%'"
  },
  {
   "table": "user_reviews",
   "column": "Sentiment",
   "formula": "Sentiment IS NULL OR Sentiment IN ('Positive', 'Negative', 'Neutral', 'nan')"
  },
  {
   "table": "user_reviews",
   "column": "Sentiment_Polarity",
   "formula": "Sentiment_Polarity IS NULL OR Sentiment_Polarity = 'nan' OR CAST(Sentiment_Polarity AS REAL) BETWEEN -1.0 AND 1.0"
  },
  {
   "table": "user_reviews",
   "column": "Sentiment_Subjectivity",
   "formula": "Sentiment_Subjectivity IS NULL OR Sentiment_Subjectivity = 'nan' OR CAST(Sentiment_Subjectivity AS REAL) BETWEEN 0.0 AND 1.0"
  }
 ],
