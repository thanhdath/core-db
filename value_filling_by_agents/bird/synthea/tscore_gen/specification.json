 "semantic_rules_and_formulas": [
  {
   "table": "all_prevalences",
   "column": "PREVALENCE RATE",
   "formula": "PREVALENCE RATE BETWEEN 0 AND 1"
  },
  {
   "table": "all_prevalences",
   "column": "PREVALENCE PERCENTAGE",
   "formula": "abs(PREVALENCE PERCENTAGE - PREVALENCE RATE * 100) < 0.001",
   "evidence": "0.868->86.8, 0.487->48.7, 0.117->11.7"
  },
  {
   "table": "all_prevalences",
   "column": "OCCURRENCES",
   "formula": "OCCURRENCES >= 0"
  },
  {
   "table": "all_prevalences",
   "column": "POPULATION COUNT",
   "formula": "POPULATION COUNT > 0"
  },
  {
   "table": "patients",
   "column": "gender",
   "formula": "gender IN ('F','M')"
  },
  {
   "table": "patients",
   "column": "race",
   "formula": "race IN ('black','white','hispanic','asian')"
  },
  {
   "table": "patients",
   "column": "marital",
   "formula": "marital IN ('S','M')"
  },
  {
   "table": "patients",
   "column": "prefix",
   "formula": "prefix IN ('Mr.','Mrs.','Ms.')"
  },
  {
   "table": "patients",
   "column": "suffix",
   "formula": "suffix IN ('PhD','JD','MD')"
  },
  {
   "table": "patients",
   "column": "deathdate",
   "formula": "deathdate IS NULL OR deathdate > birthdate"
  },
  {
   "table": "encounters",
   "column": "DATE",
   "formula": "DATE >= (SELECT birthdate FROM patients WHERE patient = encounters.PATIENT)"
  },
  {
   "table": "careplans",
   "column": "STOP",
   "formula": "STOP IS NULL OR STOP >= START"
  },
  {
   "table": "conditions",
   "column": "STOP",
   "formula": "STOP IS NULL OR STOP >= START"
  },
  {
   "table": "medications",
   "column": "STOP",
   "formula": "STOP IS NULL OR STOP >= START"
  },
  {
   "table": "claims",
   "column": "TOTAL",
   "formula": "TOTAL >= 0"
  },
  {
   "table": "observations",
   "column": "VALUE",
   "formula": "VALUE IS NULL OR VALUE BETWEEN -1000 AND 1000"
  }
 ],
