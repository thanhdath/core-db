{
 "generic_sampling_rules": {
  "text_identifier": "UUID-like hex string, unique per row; primary keys never NULL",
  "text_name": "person-like name from a pool of ~1200 first names and ~450 last names; duplicates allowed (20-50% duplicate share on DISTINCT queries)",
  "text_enum": "value drawn from the column's enum pool; case variants (lower/upper) appear as near-variants",
  "text_free": "short English phrase; near-variants (case change, trailing space, one-char edit) appear for LIKE/equality literals",
  "integer_code": "integer drawn from the column's code pool; no NULL unless column nullable",
  "integer_count": "non-negative integer; NULL only if column nullable",
  "real_measure": "REAL in the column's observed range; NULL only if column nullable",
  "date_iso": "date string %Y-%m-%d; boundary values at year/month/day edges of listed literals",
  "date_us": "date string %m/%d/%y",
  "null_share": "for nullable columns, ~10-30% NULL rows per instance, at least one NULL row",
  "fresh_value_share": "~30% of rows get fresh values not seen in the seed sample"
 },
