{
 "generic_sampling_rules": {
  "integer_pk": "sequential from 1, unique, never NULL",
  "integer_fk": "copy from the parent key pool actually written (parents generated first); for nullable FK columns plant NULL on a share matching the compact DB (at least one NULL per nullable FK); ensure some parent rows have no children",
  "composite_fk": "sample the child FK as a tuple from the parent's composite key set actually written (never column-by-column)",
  "integer_quantity": "uniform integer in [1, 1000]",
  "integer_small": "uniform integer in [0, 100]",
  "real_amount": "round(uniform(0, 100000), 4)",
  "real_rate": "round(uniform(0, 1), 4)",
  "real_price": "round(uniform(0, 5000), 4)",
  "text_short": "random word from a 200-word pool, 1-20 chars",
  "text_name": "random capitalized word, unique per table where UNIQUE and never overwritten by duplicates/ties",
  "text_code": "upper-case 2-4 letter code",
  "text_long": "random sentence 20-200 chars",
  "text_xml": "fixed small XML template",
  "blob": "random bytes of length 100-1000",
  "datetime": "uniform between 2005-01-01 and 2014-12-31, format %Y-%m-%d %H:%M:%S",
  "date": "uniform between 1950-01-01 and 2014-12-31, format %Y-%m-%d",
  "rowguid": "uuid4 string, unique",
  "modified_date": "uniform between 2008-01-01 and 2014-12-31",
  "flag": "random choice of 0 or 1",
  "near_variant": "for each listed literal, generate exact, lower-case, upper-case, one-char-edit, and one-char-append variants",
  "boundary": "for each listed numeric literal L with step s, generate L-s, L, L+s; for dates generate L-1day, L, L+1day in the column's format",
  "null_share": "for nullable columns, plant at least one NULL and a NULL share matching the compact database's share (5-30% unless statistics show otherwise); never replace a planted NULL to satisfy a rule; run NULL planting after dedupe and never drop NULL rows",
  "duplicates": "for DISTINCT-target columns, 20-50% of rows share values with another row; only for non-UNIQUE, non-PK columns",
  "ties": "for ORDER-target columns, ensure at least two rows share the value at the listed rank; only on columns where uniqueness is not required",
  "unmatched_join": "for join-target columns, ensure some parent rows have no child rows and (where nullable) some child rows carry NULL FK"
 },
