{
 "generic_sampling_rules": {
  "text_short": "Sample from a small pool of realistic short strings; 5% of rows get a near-variant (case change, trailing space, or one-character edit) of a pool value; NULL only where nullable.",
  "text_long": "Sample from a pool of realistic sentences; 5% near-variants; NULL only where nullable.",
  "integer": "Sample uniformly from the stated range; include boundary values and one step on each side; NULL only where nullable.",
  "real": "Sample uniformly from the stated range with one decimal; include boundary values; NULL only where nullable.",
  "date_iso": "Sample a date in %Y-%m-%d format within the stated range; include boundary dates and one day on each side; NULL only where nullable.",
  "enum": "Sample uniformly from the listed values; 5% near-variants (case change) where the column is free text; NULL only where nullable.",
  "flag": "Sample from the listed flag values; NULL only where nullable.",
  "fresh_share": "0.15 of text values are fresh (not reused from the pool) to create near-duplicates and unmatched joins.",
  "null_share_default": "Use the compact database null rate for the column, at least one NULL row per nullable column; plant NULLs in nullable foreign keys too.",
  "fk_integrity": "Every non-NULL foreign-key value must be drawn from the final surviving parent key set after PK/unique dedup and after compact+generated merge; validate references before insert and never emit a dangling FK.",
  "boundary_survival": "Apply duplicate and tie injection before boundary injection, or exclude boundary rows from overwrite, so every specified boundary value is present in each instance.",
  "tie_planting": "For ORDER columns with tie_at_rank targets, deterministically set the two extreme rows to the same min and the two to the same max after boundary injection.",
  "min_rows": "Each table has at least as many rows as the largest boundary list for its columns; cycle boundaries across rows so all are present."
 },
